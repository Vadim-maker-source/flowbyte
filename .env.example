POSTGRES_DB=flowbyte
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
API_PORT=2345

# Copy this file to .env, then add your private Authorization Key from GigaChat Studio.
# This is Base64(Client ID:Client Secret), WITHOUT the "Basic " prefix.
# Never commit .env or put this key in mobile, screenshots or source code.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Optional: path inside the API container to a CA bundle trusted by GigaChat.
GIGACHAT_CA_BUNDLE=
ASSISTANT_TIMEOUT_SECONDS=45
